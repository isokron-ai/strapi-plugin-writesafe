{
  "kind": "collectionType",
  "collectionName": "galleries",
  "info": { "singularName": "gallery", "pluralName": "galleries", "displayName": "Gallery", "description": "Test type for the media module (v1-media): media at top level and inside a repeatable component; a multiple media field and a to-many relation (1.0 hardening: whole-list set needs a version)." },
  "options": { "draftAndPublish": true },
  "attributes": {
    "title": { "type": "string", "required": true },
    "cover": { "type": "media", "multiple": false, "allowedTypes": ["images", "files"] },
    "screens": { "type": "component", "repeatable": true, "component": "gallery.screen" },
    "feature": { "type": "component", "repeatable": false, "component": "gallery.feature" },
    "slides": { "type": "component", "repeatable": true, "component": "gallery.slide" },
    "images": { "type": "media", "multiple": true, "allowedTypes": ["images", "files"] },
    "contributors": { "type": "relation", "relation": "manyToMany", "target": "api::author.author" },
    "groups": { "type": "component", "repeatable": true, "component": "shared.group" }
  }
}
