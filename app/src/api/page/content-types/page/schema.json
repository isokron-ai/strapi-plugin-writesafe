{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Page"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "summary": {
      "type": "text"
    },
    "note": {
      "type": "string"
    },
    "body": {
      "type": "blocks"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "items": {
      "type": "component",
      "repeatable": true,
      "component": "shared.item"
    },
    "sections": {
      "type": "dynamiczone",
      "components": [
        "blocks.text",
        "blocks.hero",
        "blocks.cta",
        "blocks.quote",
        "blocks.gallery"
      ]
    },
    "credits": {
      "type": "component",
      "repeatable": true,
      "component": "shared.credit"
    },
    "screens": {
      "type": "component",
      "repeatable": true,
      "component": "shared.screen"
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "reviewer": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::author.author"
    }
  }
}
